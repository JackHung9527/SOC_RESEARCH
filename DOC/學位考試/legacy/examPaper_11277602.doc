 <tr style='mso-yfti-irow:1;height:29.7pt'>
  <td width=122 valign=top style='width:91.4pt;padding:0cm 0cm 0cm 0cm;
  height:29.7pt'>
  <p class=MsoNormal style='margin-top:9.0pt;mso-para-margin-top:.5gd;
  text-align:justify;text-justify:inter-ideograph;line-height:15.0pt;
  mso-line-height-rule:exactly'><span style='font-size:13.0pt;font-family:標楷體;
  mso-ascii-font-family:"Academy Engraved LET";mso-hansi-font-family:"Academy Engraved LET"'>學位類別：</span><span
  lang=EN-US style='font-size:13.0pt;font-family:"Academy Engraved LET";
  mso-fareast-font-family:標楷體;mso-bidi-font-weight:bold'><o:p></o:p></span></p>
